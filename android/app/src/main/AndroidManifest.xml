<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- AdMob 이 광고 식별자를 읽기 위해 필요 (Android 13+) -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />

    <!--
        allowBackup 은 Hive SDK 가 선언한 값(false)과 맞춘다.
        인증 토큰이 구글 드라이브 자동 백업으로 새어 나가지 않게 하기 위한 것이다.

        usesCleartextTraffic 은 일부러 선언하지 않는다.
        Hive SDK 가 true 를 요구하므로(로그인/문의 웹뷰), 여기서 false 로 덮으면
        Hive 화면이 깨진다. 게임 자체는 앱 안의 asset 만 로드하므로 평문 트래픽을 쓰지 않는다.
    -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.NextStop">

        <!-- AdMob 앱 ID. 값은 gradle.properties 의 admob.appId 에서 주입된다. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|density|fontScale|navigation|keyboard|touchscreen|locale|layoutDirection"
            android:hardwareAccelerated="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
